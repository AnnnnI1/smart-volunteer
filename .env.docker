# Docker 环境变量配置
# 复制此文件为 .env 并填入真实值

# MySQL
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=smart_volunteer
MYSQL_USER=userstest
MYSQL_PASSWORD=123456

# DeepSeek API（AI 风控/NL2SQL/推荐语）
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
DEEPSEEK_MODEL=deepseek-chat

# JWT 签名密钥
JWT_SECRET=smart-volunteer-secret

# HuggingFace 镜像（国内加速）
HF_ENDPOINT=https://hf-mirror.com
